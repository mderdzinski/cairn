--swiftversion 5.9
--indent 4
--maxwidth 120
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
--commas always
--trimwhitespace always
--ifdef no-indent
--self remove
--patternlet inline
--stripunusedargs closure-only
--header strip

# Enabled by default since SwiftFormat 0.62; conflict with existing repo style
# (single-line if bodies, regular comments on non-API declarations).
--disable wrapIfStatementBodies,docComments

--exclude .build,build,DerivedData,**/.build,Packages/*/.build,**/Generated
